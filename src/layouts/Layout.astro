---
import '../styles/global.css';
import WhatsAppButton from '../components/WhatsAppButton.astro';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "CarInsure — Drive on, we've got you",
  description = 'Car insurance for glass, collision, flood, theft and roadside help.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700&family=Rubik:wght@400;500&display=swap" rel="stylesheet">
</head>
<body>
  <slot />
  <WhatsAppButton />
</body>
</html>
