---
import { useTranslations } from '../i18n/index.js';
const t = useTranslations(Astro.props.lang);
---
<section class="block block-tint" id="claims">
  <h2>{t.claims.title}</h2>
  <ol class="grid steps">
    {t.claims.steps.map(([title, text]) => <li><h3>{title}</h3><p>{text}</p></li>)}
  </ol>
</section>
