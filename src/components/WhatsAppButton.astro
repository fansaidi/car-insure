---
/* Floating "chat on WhatsApp" button: a plain wa.me link, no third-party script. */
import { whatsappLink } from '../data/contact.js';

const href = whatsappLink('Hi CarInsure, I have a question about car insurance.');
---
<a class="chat" href={href} target="_blank" rel="noopener noreferrer" aria-label="Chat with us on WhatsApp (opens in a new tab)" title="Chat on WhatsApp">
  <svg viewBox="0 0 32 32" aria-hidden="true">
    <path class="bubble" d="M16 3.5a12.5 12.5 0 0 0-10.8 18.8L3.5 28.5l6.4-1.7A12.5 12.5 0 1 0 16 3.5Z" />
    <path class="phone" d="M12.1 9.8c.5 0 .9 0 1.200.1l1.6 3.8-1.300 1.700c1.300 2.6 3.2 4.4 5.800 5.6l1.400-1.700 3.700 1.800c0 1.600-1.200 3.100-3 3.300-5.200.4-12.100-6.300-11.900-11.200.1-1.900 1.300-3.200 2.500-3.400Z" />
  </svg>
</a>

<style>
  .chat {
    position: fixed; z-index: 15; display: grid; place-items: center; width: 56px; height: 56px;
    right: max(16px, env(safe-area-inset-right)); bottom: max(16px, env(safe-area-inset-bottom));
    border: 2px solid #fff; border-radius: 50%; background: #15803d; box-shadow: 0 6px 20px rgb(0 0 0 / .28);
    transition: background-color .2s;
  }
  .chat:hover { background: #166534; }
  svg { width: 32px; height: 32px; }
  .bubble { fill: none; stroke: #fff; stroke-width: 2.4; stroke-linejoin: round; }
  .phone { fill: #fff; }
</style>
