---
import { useTranslations } from '../i18n/index.js';
const t = useTranslations(Astro.props.lang);
---
<section class="block" id="faq">
  <h2>{t.faq.title}</h2>
  <div class="narrow">
    {t.faq.items.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}
  </div>
</section>
