---
import { useTranslations } from '../i18n/index.js';
import { paths } from '../data/paths.js';

const { lang } = Astro.props;
const t = useTranslations(lang);
const plans = [['Basic', '$19'], ['Plus', '$34'], ['Max', '$49']];
---
<section class="block" id="plans">
  <h2>{t.plans.title}</h2>
  <p class="lead">{t.plans.lead}</p>
  <div class="grid">
    {plans.map(([name, price]) => (
      <article class:list={['plan', { 'plan-best': name === 'Plus' }]}>
        {name === 'Plus' && <p class="badge">{t.plans.best}</p>}
        <h3>{name}</h3>
        <p class="price">{price}<span>{t.plans.perMonth}</span></p>
        <ul>{t.plans.items[name].map((item) => <li>{item}</li>)}</ul>
        <a class:list={['btn', { 'btn-ghost': name !== 'Plus' }]} href={`${paths(lang).quote}?plan=${name}`}>{t.plans.choose} {name}</a>
      </article>
    ))}
  </div>
</section>
