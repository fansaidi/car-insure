---
import { useTranslations } from '../i18n/index.js';
import { paths } from '../data/paths.js';
import Arrow from './Arrow.astro';

const { lang } = Astro.props;
const t = useTranslations(lang);
// Section order, so each card knows its neighbours
const order = ['home', ...t.chapters.map((c) => c.id), 'arrive'];
---
<div class="story" id="story">
  <div class="stage" aria-hidden="true">
    <svg id="scene" preserveAspectRatio="xMidYMid meet"></svg>
  </div>

  <div class="chapters">
    <section class="chapter chapter-hero" id="home" data-scene="hero">
      <div class="card">
        <h1>{t.hero.title[0]}<br />{t.hero.title[1]}</h1>
        <p>{t.hero.text}</p>
        <div class="actions">
          <a class="btn" href={paths(lang).quote}>{t.hero.quote}</a>
          <a class="btn btn-ghost" href="#glass" data-scroll>{t.hero.start}</a>
        </div>
      </div>
    </section>

    {t.chapters.map((c, i) => (
      <section class="chapter" id={c.id}>
        <div class="card">
          <p class="eyebrow">{c.eyebrow}</p>
          <h2>{c.title}</h2>
          <p>{c.text}</p>
          <div class="card-foot">
            <p class="status"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5 10 17.5 19 7" /></svg> {c.status}</p>
            <div class="pager">
              <Arrow direction="prev" label={t.arrows.prev} to={order[i]} />
              <Arrow direction="next" label={t.arrows.next} to={order[i + 2]} />
            </div>
          </div>
        </div>
      </section>
    ))}

    <section class="chapter" id="arrive" data-scene="arrive">
      <div class="card">
        <p class="eyebrow">{t.arrive.eyebrow}</p>
        <h2>{t.arrive.title}</h2>
        <p>{t.arrive.text}</p>
        <div class="actions">
          <a class="btn" href="#plans" data-scroll>{t.arrive.compare}</a>
          <div class="pager"><Arrow direction="prev" label={t.arrows.prev} to={order.at(-2)} /></div>
        </div>
        <p class="fine">{t.arrive.fine}</p>
      </div>
    </section>
  </div>
</div>

<script>
  import '../scripts/story.js';
</script>
