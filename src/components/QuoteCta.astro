---
import { useTranslations } from '../i18n/index.js';
import { paths } from '../data/paths.js';
const { lang } = Astro.props;
const t = useTranslations(lang);
/* Call to action that carries the number plate over to the quote page.
   A plain GET form, so it works without JavaScript. */
---
<section class="block block-dark" id="quote">
  <h2>{t.cta.title}</h2>
  <p class="cta-lead">{t.cta.lead}</p>
  <form class="cta" action={paths(lang).quote} method="get">
    <label for="cta-plate">{t.cta.plate}</label>
    <div class="cta-row">
      <input id="cta-plate" name="plate" placeholder={t.cta.example} maxlength="12" autocomplete="off" autocapitalize="characters" spellcheck="false">
      <button class="btn" type="submit">{t.cta.button}</button>
    </div>
  </form>
</section>

<style>
  .cta-lead { margin-top: 12px; color: #e0f2fe; }
  .cta { max-width: 560px; margin: 28px auto 0; text-align: left; }
  .cta label { margin: 0; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 12px; }
  .cta-row input { flex: 1 1 220px; min-width: 0; text-transform: uppercase; }
  .cta-row input::placeholder { text-transform: none; }
  .cta .cta-row .btn { flex: 1 0 auto; margin: 0; }
  @media (min-width: 560px) { .cta .cta-row .btn { flex-grow: 0; } }
</style>
