---
import { home } from '../data/paths.js';
import Layout from '../layouts/Layout.astro';
---
<Layout title="Get a car insurance quote — CarInsure" description="Get a free car insurance quote with your number plate and a few details.">
  <header class="nav">
    <a class="logo" href={home}>
      <svg viewBox="-50 -55 100 112" aria-hidden="true"><path class="logo-shield" d="M0-50 42-34V4C42 30 22 46 0 54-22 46-42 30-42 4V-34Z"/><path class="logo-tick" d="M-19 2-5 16 21-12"/></svg>
      CarInsure
    </a>
  </header>

  <main class="quote">
    <a class="back" href={home}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
      Back
    </a>
    <h1>Get your free quote</h1>
    <p class="chosen" id="chosen" hidden></p>

    <!-- method="post" keeps personal details out of the address bar if scripts fail -->
    <form id="quote-form" method="post" novalidate>
      <div class="field plate">
        <label for="plate">Vehicle registration number</label>
        <input id="plate" name="plate" placeholder="e.g. ABC1234" maxlength="12" autocomplete="off" autocapitalize="characters" spellcheck="false" required aria-describedby="plate-help plate-error">
        <p class="help" id="plate-help">Private vehicles only. Taxis, buses and lorries are not accepted.</p>
        <p class="error" id="plate-error" hidden></p>
      </div>
      <label class="check"><input type="checkbox" id="no-plate" name="noPlate"> New car, no number plate yet.</label>

      <div class="field">
        <label for="id-type">ID type</label>
        <select id="id-type" name="idType">
          <option value="nric">NRIC</option>
          <option value="passport">Passport</option>
          <option value="police">Police IC</option>
          <option value="army">Military IC</option>
          <option value="company">Company registration</option>
        </select>
      </div>
      <div class="field">
        <label for="id-number" id="id-label">Vehicle owner's NRIC number</label>
        <input id="id-number" name="idNumber" placeholder="XXXXXX-XX-XXXX" inputmode="numeric" autocomplete="off" required aria-describedby="id-help id-number-error">
        <p class="help" id="id-help">Needed to apply your No-Claim Discount (NCD). Check it is correct.</p>
        <p class="error" id="id-number-error" hidden></p>
      </div>

      <h2>We will send your quote to you.</h2>
      <div class="field">
        <label for="name" id="name-label">Owner's name</label>
        <input id="name" name="name" placeholder="As on your ID" autocomplete="name" required aria-describedby="name-error">
        <p class="error" id="name-error" hidden></p>
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" placeholder="name@example.com" autocomplete="email" required aria-describedby="email-help email-error">
        <p class="help" id="email-help">Your quote will be sent by email.</p>
        <p class="error" id="email-error" hidden></p>
      </div>
      <div class="field">
        <label for="phone">WhatsApp number</label>
        <div class="prefixed">
          <span aria-hidden="true">+60</span>
          <input id="phone" name="phone" type="tel" placeholder="12 345 6789" inputmode="tel" autocomplete="tel-national" required aria-describedby="phone-help phone-error">
        </div>
        <p class="help" id="phone-help">Malaysian number, without the leading 0.</p>
        <p class="error" id="phone-error" hidden></p>
      </div>
      <div class="field">
        <label for="postcode">Postcode for cover note</label>
        <input id="postcode" name="postcode" placeholder="50050" inputmode="numeric" maxlength="5" autocomplete="postal-code" required aria-describedby="postcode-help postcode-error">
        <p class="help" id="postcode-help">Your price depends on your postcode.</p>
        <p class="error" id="postcode-error" hidden></p>
      </div>
      <div class="field">
        <label for="promo">Promo code (optional)</label>
        <input id="promo" name="promoCode" maxlength="20" autocomplete="off" autocapitalize="characters" spellcheck="false">
      </div>
      <label class="check"><input type="checkbox" id="by-whatsapp" name="sendByWhatsApp"> Yes, send my quote via WhatsApp.</label>

      <p class="consent">By submitting this form, I agree to receive emails from CarInsure, and I have read and agree to the Terms and Conditions and the Privacy Policy.</p>
      <button class="btn submit" type="submit">Get quote</button>
      <p class="help demo">Design prototype: nothing you type is sent or saved.</p>
    </form>

    <section class="done" id="done" hidden tabindex="-1" aria-labelledby="done-title">
      <h2 id="done-title">Details look complete</h2>
      <p id="done-text"></p>
      <div class="done-actions">
        <a class="btn whatsapp" id="whatsapp" target="_blank" rel="noopener noreferrer" hidden>Get my quote on WhatsApp</a>
        <a class="btn btn-ghost" href={home}>Back to home</a>
      </div>
    </section>
  </main>
</Layout>

<script>
  import '../scripts/quote.js';
</script>

<style>
  .quote { max-width: 560px; margin: 0 auto; padding: calc(var(--nav-h) + 20px) 16px 96px; }
  .back { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; color: var(--primary); font-weight: 500; text-decoration: none; }
  .back svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  h1 { margin-top: 8px; font-size: clamp(1.8rem, 6vw, 2.4rem); }
  .chosen { margin-top: 8px; color: var(--muted); }
  form { display: block; margin-top: 20px; }
  form h2 { margin-top: 28px; padding-top: 28px; border-top: 1px solid var(--border); font-size: 1.4rem; }
  [hidden] { display: none !important; }

  .field { display: flex; flex-direction: column; gap: 6px; margin-top: 16px; }
  .field label { margin: 0; }
  .field input, .field select { width: 100%; min-width: 0; }
  .plate input { text-transform: uppercase; }
  .plate input::placeholder { text-transform: none; }
  input:disabled { background: var(--bg); cursor: not-allowed; }
  .field input[aria-invalid="true"] { border-color: var(--danger); }
  .error { color: var(--danger); font-size: .875rem; }
  .help { margin-top: 0; color: var(--muted); font-size: .875rem; }
  .check { display: flex; width: fit-content; align-items: center; gap: 10px; min-height: 44px; margin: 0; font-weight: 400; text-align: left; cursor: pointer; }
  .check input { flex: none; width: 20px; height: 20px; min-height: 0; accent-color: var(--primary); }
  .prefixed { display: flex; align-items: stretch; gap: 8px; }
  .prefixed span { display: grid; place-items: center; padding: 0 14px; border: 2px solid var(--border); border-radius: 10px; background: var(--bg); }
  .consent { margin-top: 20px; color: var(--muted); font-size: .875rem; }
  form .submit { width: 100%; margin-top: 16px; background: var(--primary); border-color: var(--primary); color: var(--on-primary); }
  form .submit:hover { background: #075985; border-color: #075985; color: #fff; }
  .demo { margin-top: 12px; text-align: center; }
  .done { margin-top: 24px; padding: 24px; background: var(--card); border: 2px solid var(--accent); border-radius: 16px; }
  .done p { margin: 12px 0 20px; }
  .done-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  /* dark enough for white text */
  .whatsapp, .whatsapp:hover { background: #15803d; border-color: #15803d; color: #fff; }
  .whatsapp:hover { background: #166534; border-color: #166534; }
</style>
